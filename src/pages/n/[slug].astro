---
import Layout from '../../layouts/Layout.astro';
import { getNoticias } from '../../lib/airtable';

export async function getStaticPaths() {
  const noticias = await getNoticias();
  
  // Cria os caminhos apenas para notícias que possuem um Slug válido
  return noticias.map((n) => ({
    params: { slug: n.Slug },
    props: { noticia: n },
  }));
}

const { noticia } = Astro.props;
---

<Layout title={noticia.Titulo}>
  <article style="max-width: 800px; margin: 0 auto; padding: 40px 20px;">
    <span style="color: #c4170c; font-weight: 800; text-transform: uppercase;">{noticia.Chapeu}</span>
    <h1 style="font-size: 3rem; margin: 20px 0; line-height: 1.1;">{noticia.Titulo}</h1>
    <p style="font-size: 1.3rem; color: #666; margin-bottom: 30px;">{noticia.Subtitulo}</p>
    
    {noticia.Imagem && (
      <img src={noticia.Imagem} style="width: 100%; border-radius: 8px; margin-bottom: 30px;" />
    )}
    
    <div style="line-height: 1.8; font-size: 1.1rem;">
      <p>Conteúdo da auditoria BlueNews em desenvolvimento...</p>
    </div>
  </article>
</Layout>