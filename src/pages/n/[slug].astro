---
import Layout from '../../layouts/Layout.astro';
import { getNoticias } from '../../lib/airtable';

export async function getStaticPaths() {
  const noticias = await getNoticias();
  // Garante que o build só tente criar páginas para notícias reais
  return noticias.map((n) => ({
    params: { slug: n.Slug },
    props: { noticia: n },
  }));
}

const { noticia } = Astro.props;
---
<Layout title={noticia?.Titulo || "Notícia"}>
  <article style="max-width: 800px; margin: 40px auto; padding: 0 20px;">
    <h1 style="font-size: 3rem; font-weight: 900;">{noticia?.Titulo}</h1>
    <p style="font-size: 1.4rem; color: #666; margin: 20px 0;">{noticia?.Subtitulo}</p>
    <img src={noticia?.Imagem} style="width: 100%; border-radius: 12px;" />
  </article>
</Layout>