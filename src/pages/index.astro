---
import Layout from '../layouts/Layout.astro';
import { getNoticias } from '../lib/airtable';

// 1. Captação da Corrente (Dados)
const noticias = await getNoticias();

// 2. DISJUNTOR DE SEGURANÇA: Define a manchete principal
const principal = noticias.find(n => n.Destaque === true) || noticias[0];

// Se o sinal do Airtable falhar, redireciona para evitar erro 500
if (!principal) {
  return Astro.redirect('/404'); 
}

// 3. Distribuição por Hierarquia (Padrão Globo.com)
const secundariasComFoto = noticias.filter(n => n.id !== principal.id && n.Tipo_Layout === "Com Imagem").slice(0, 4);
const apenasTexto = noticias.filter(n => n.id !== principal.id && n.Tipo_Layout === "Apenas Texto").slice(0, 6);
---

<Layout title="BlueNews - Informação com Valor">
  
  <section style="margin-bottom: 40px; margin-top: 20px;">
    <a href={`/n/${principal.Slug}`} style="text-decoration: none; color: inherit; display: grid; grid-template-columns: 2fr 1fr; gap: 20px; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
        <div style="background: #eee; height: 450px;">
            <img src={principal.Imagem} style="width: 100%; height: 100%; object-fit: cover;" alt={principal.Titulo} />
        </div>
        <div style="padding: 40px; display: flex; flex-direction: column; justify-content: center; background: #fff;">
            <span style="color: #c4170c; font-weight: 800; font-size: 0.75rem; text-transform: uppercase;">{principal.Chapeu}</span>
            <h1 style="font-size: 2.5rem; margin: 15px 0; line-height: 1.1; font-weight: 900; letter-spacing: -1.5px;">{principal.Titulo}</h1>
            <p style="color: #666; font-size: 1.1rem; line-height: 1.4;">{principal.Subtitulo}</p>
            <div style="margin-top: 20px; font-weight: bold; color: #0669b2;">✓ AUDITADO [+1 CYCL]</div>
        </div>
    </a>
  </section>

  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 50px;">
    {secundariasComFoto.map(n => (
      <a href={`/n/${n.Slug}`} style="text-decoration: none; color: inherit; background: #fff; padding: 15px; border-radius: 8px; border: 1px solid #eee; transition: transform 0.2s;">
        <img src={n.Imagem} style="width: 100%; height: 160px; object-fit: cover; border-radius: 4px;" />
        <span style="color: #c4170c; font-weight: bold; font-size: 0.7rem; display: block; margin-top: 10px;">{n.Chapeu}</span>
        <h3 style="font-size: 1rem; margin: 5px 0; line-height: 1.2; font-weight: 700;">{n.Titulo}</h3>
      </a>
    ))}
  </div>

  <section style="border-top: 2px solid #eee; padding-top: 30px; margin-bottom: 60px;">
    <h2 style="font-size: 0.9rem; color: #999; text-transform: uppercase; margin-bottom: 25px; font-weight: 800;">Mais Notícias</h2>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px;">
      {apenasTexto.map(n => (
        <a href={`/n/${n.Slug}`} style="text-decoration: none; border-bottom: 1px solid #f0f0f0; padding-bottom: 15px;">
          <span style="color: #0669b2; font-weight: 800; font-size: 0.7rem; display: block; margin-bottom: 5px;">{n.Chapeu}</span>
          <h3 style="font-size: 1.1rem; color: #333; margin: 0; line-height: 1.3; font-weight: 700;">{n.Titulo}</h3>
        </a>
      ))}
    </div>
  </section>

</Layout>

<style>
  a:hover { transform: translateY(-3px); }
</style>